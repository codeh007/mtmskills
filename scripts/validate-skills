#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

found=0
while IFS= read -r -d '' skill_md; do
  found=1
  skill_dir="$(dirname "$skill_md")"
  skill_name="$(basename "$skill_dir")"

  python3 - "$skill_md" "$skill_name" <<'PY'
import pathlib
import re
import sys

import yaml

skill_md = pathlib.Path(sys.argv[1])
folder_name = sys.argv[2]
content = skill_md.read_text(encoding="utf-8")

if not content.startswith("---\n"):
    raise SystemExit(f"{skill_md}: missing YAML frontmatter")

match = re.match(r"^---\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
if not match:
    raise SystemExit(f"{skill_md}: invalid YAML frontmatter block")

try:
    frontmatter = yaml.safe_load(match.group(1)) or {}
except yaml.YAMLError as exc:
    raise SystemExit(f"{skill_md}: invalid YAML frontmatter: {exc}") from exc

if not isinstance(frontmatter, dict):
    raise SystemExit(f"{skill_md}: YAML frontmatter must be a mapping")

name = str(frontmatter.get("name", "")).strip()
description = str(frontmatter.get("description", "")).strip()

if not name:
    raise SystemExit(f"{skill_md}: missing required frontmatter key 'name'")
if not description:
    raise SystemExit(f"{skill_md}: missing required frontmatter key 'description'")
if name != folder_name:
    raise SystemExit(f"{skill_md}: frontmatter name '{name}' does not match folder '{folder_name}'")
if not re.match(r"^[a-z0-9-]+$", name):
    raise SystemExit(f"{skill_md}: name must use lowercase letters, digits, and hyphens only")
if name.startswith("-") or name.endswith("-") or "--" in name:
    raise SystemExit(f"{skill_md}: name cannot start/end with hyphen or contain consecutive hyphens")
if len(name) > 64:
    raise SystemExit(f"{skill_md}: name exceeds 64 characters")
if len(description) > 1024:
    raise SystemExit(f"{skill_md}: description exceeds 1024 characters")
if "<" in description or ">" in description:
    raise SystemExit(f"{skill_md}: description cannot contain angle brackets")

body = content[match.end():].strip()
if not body:
    raise SystemExit(f"{skill_md}: body cannot be empty")

print(f"{name}: valid")
PY

done < <(find "$repo_root/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print0 | sort -z)

if [[ "$found" -eq 0 ]]; then
  echo "No skills found under $repo_root/skills" >&2
  exit 1
fi

echo "All skills are valid."