# Hermes Agent default environment template
# Audience: normal/non-developer users.
# Copy values into ~/.hermes/.env or the target service secret store.

HERMES_MODEL_BASE_URL=https://<provider-host>/v1
HERMES_MODEL_API_KEY=<redacted>

# Optional Telegram gateway. Use numeric Telegram user IDs, not usernames.
TELEGRAM_BOT_TOKEN=<redacted>
TELEGRAM_ALLOWED_USERS=<numeric-user-id>

# Optional group access.
TELEGRAM_GROUP_ALLOWED_USERS=<numeric-user-id>
TELEGRAM_GROUP_ALLOWED_CHATS=<negative-chat-id>
