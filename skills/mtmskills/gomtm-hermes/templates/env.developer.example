# Hermes Agent developer environment template
# Copy values into ~/.hermes/.env, profile env, container secrets, or service env.
# Do NOT default HERMES_TUI=1 on shared/service hosts; it breaks Kanban/cron/non-TTY workers.
# Use `hermes --tui` explicitly for interactive TUI sessions.

OPENAI_BASE_URL=https://<provider-host>/v1
OPENAI_API_KEY=<redacted>

# Optional Telegram gateway for developer-owned bot sessions.
TELEGRAM_BOT_TOKEN=<redacted>
TELEGRAM_ALLOWED_USERS=<numeric-user-id>

# Optional group access.
TELEGRAM_GROUP_ALLOWED_USERS=<numeric-user-id>
TELEGRAM_GROUP_ALLOWED_CHATS=<negative-chat-id>

# Optional GitNexus tuning. Prefer CLI flags for one-off runs.
# GITNEXUS_SKIP_OPTIONAL_GRAMMARS=1
# GITNEXUS_WORKER_POOL_SIZE=4
# GITNEXUS_VERBOSE=1
