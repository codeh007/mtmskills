# Hermes Agent environment template for the gomtm default setup.
# Copy this file to ~/.hermes/.env, a profile env, container secrets, or service env.
#
# Default model path:
#   provider: Sub2api.yuepa8.com
#   endpoint: https://sub2api.yuepa8.com/v1
#   model: gpt-5.5
#   context_length: 400000 (configured in templates/config.yaml; current relay plan)
#   reasoning_effort: medium (configured in templates/config.yaml)
#
# Keep secrets out of config.yaml. Only OPENAI_API_KEY must be replaced below.

OPENAI_BASE_URL=https://sub2api.yuepa8.com/v1
OPENAI_API_KEY=<redacted>
HERMES_MODEL=gpt-5.5

# Keep unset for normal use. `security.redact_secrets: true` in config.yaml
# enables redaction. Setting HERMES_REDACT_SECRETS=false overrides config.yaml
# and makes Hermes print a startup warning.
# HERMES_REDACT_SECRETS=true

# Do not set HERMES_TUI=1 in shared/service environments. It forces non-TTY
# commands, Kanban workers, cron jobs, and gateway background tasks into TUI mode.
# Use `hermes --tui` explicitly for interactive sessions.
# HERMES_TUI=0

# Optional Telegram gateway. Use numeric Telegram user IDs, not usernames.
# TELEGRAM_BOT_TOKEN=<redacted>
# TELEGRAM_ALLOWED_USERS=<numeric-user-id>
# TELEGRAM_HOME_CHANNEL=<numeric-chat-id>

# Optional Telegram group access. Group chat IDs are usually negative.
# TELEGRAM_GROUP_ALLOWED_USERS=<numeric-user-id>
# TELEGRAM_GROUP_ALLOWED_CHATS=<negative-chat-id>

# Optional terminal/browser tuning. Uncomment only when the deployment needs it.
# TERMINAL_TIMEOUT=180
# BROWSER_SESSION_TIMEOUT=120
# BROWSER_INACTIVITY_TIMEOUT=120

# Optional debug toggles. Keep disabled unless actively debugging.
# WEB_TOOLS_DEBUG=0
# VISION_TOOLS_DEBUG=0
# MOA_TOOLS_DEBUG=0
# IMAGE_TOOLS_DEBUG=0

# Optional GitNexus tuning. Prefer CLI flags for one-off runs.
# GITNEXUS_SKIP_OPTIONAL_GRAMMARS=1
# GITNEXUS_WORKER_POOL_SIZE=4
# GITNEXUS_VERBOSE=1
