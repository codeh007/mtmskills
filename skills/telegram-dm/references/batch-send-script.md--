# 批量发送脚本参考

## Python 脚本（推荐）

```python
#!/usr/bin/env python3
"""
Telegram 批量私信发送脚本
用法: python3 batch_send.py --targets targets.txt --message "消息内容" --session <session_data>
"""
import argparse
import json
import random
import sys
import time
import urllib.request

API_BASE = "http://localhost:8383"

def send_message(session_data: str, target: str, message: str) -> dict:
    """发送单条私信。target 可以是 username 或 phone"""
    payload = {"message": message, "session_data": session_data}
    
    if target.startswith("+"):
        # 先添加联系人获取 user_id
        add_payload = json.dumps({"phone": target, "first_name": "Target", "session_data": session_data}).encode()
        req = urllib.request.Request(f"{API_BASE}/v1/telegram/contact/add", data=add_payload, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            add_result = json.loads(resp.read())
        
        if not add_result.get("success"):
            return {"success": False, "message": f"添加联系人失败: {add_result.get('message', 'unknown')}", "session_data": add_result.get("session_data", session_data)}
        
        payload["user_id"] = add_result["user_id"]
        payload["access_hash"] = add_result["access_hash"]
        payload["session_data"] = add_result.get("session_data", session_data)
    else:
        # 使用 username
        target = target.lstrip("@")
        payload["username"] = target
    
    data = json.dumps(payload).encode()
    req = urllib.request.Request(f"{API_BASE}/v1/telegram/message/send", data=data, headers={"Content-Type": "application/json"})
    
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read())


def main():
    parser = argparse.ArgumentParser(description="Telegram 批量私信")
    parser.add_argument("--targets", required=True, help="目标列表文件(每行一个 username 或 +phone)")
    parser.add_argument("--message", required=True, help="消息内容")
    parser.add_argument("--session", required=True, help="session_data (base64)")
    parser.add_argument("--batch-size", type=int, default=30, help="每批数量 (默认 30)")
    parser.add_argument("--batch-delay", type=int, default=600, help="批次间隔秒数 (默认 600)")
    parser.add_argument("--min-delay", type=int, default=3, help="消息间最小间隔秒")
    parser.add_argument("--max-delay", type=int, default=10, help="消息间最大间隔秒")
    parser.add_argument("--dry-run", action="store_true", help="仅打印不实际发送")
    args = parser.parse_args()

    with open(args.targets) as f:
        targets = [line.strip() for line in f if line.strip() and not line.startswith("#")]

    print(f"📋 共 {len(targets)} 个目标, 每批 {args.batch_size}, 消息间隔 {args.min_delay}-{args.max_delay}s")

    session = args.session
    success_count = 0
    fail_count = 0
    failed_targets = []

    for i, target in enumerate(targets):
        batch_num = i // args.batch_size + 1
        batch_idx = i % args.batch_size

        if batch_idx == 0 and i > 0:
            print(f"\n⏸️  批次 {batch_num} 等待 {args.batch_delay}s...")
            if not args.dry_run:
                time.sleep(args.batch_delay)

        if args.dry_run:
            print(f"  [DRY] [{i+1}/{len(targets)}] -> {target}")
            continue

        try:
            result = send_message(session, target, args.message)
            new_session = result.get("session_data", "")
            if new_session:
                session = new_session

            if result.get("success"):
                success_count += 1
                print(f"  ✅ [{i+1}/{len(targets)}] {target}")
            else:
                fail_count += 1
                reason = result.get("message", "unknown")
                failed_targets.append({"target": target, "reason": reason})
                print(f"  ❌ [{i+1}/{len(targets)}] {target}: {reason}")

                # FLOOD_WAIT 处理
                if "FLOOD_WAIT" in reason:
                    wait = int("".join(filter(str.isdigit, reason)) or "60")
                    print(f"  ⏳ FLOOD_WAIT {wait}s...")
                    time.sleep(wait + 5)
                elif "PEER_FLOOD" in reason:
                    print("  🛑 PEER_FLOOD - 停止发送!")
                    break
        except Exception as e:
            fail_count += 1
            failed_targets.append({"target": target, "reason": str(e)})
            print(f"  💥 [{i+1}/{len(targets)}] {target}: {e}")

        delay = random.randint(args.min_delay, args.max_delay)
        time.sleep(delay)

    # 汇总
    print(f"\n📊 发送完成: ✅ {success_count} / ❌ {fail_count} / 总计 {len(targets)}")
    if failed_targets:
        print("\n失败列表:")
        for ft in failed_targets:
            print(f"  - {ft['target']}: {ft['reason']}")


if __name__ == "__main__":
    main()
```

## 目标列表文件格式 (targets.txt)

每行一个目标，支持 username 和手机号混合：

```
# 这是注释行，会被忽略
@username1
username2
+8613800138000
@target_user_3
```

## 用法示例

```bash
# 正常发送
python3 batch_send.py \
  --targets targets.txt \
  --message "你好！我们有一个很棒的项目，想跟你聊聊。" \
  --session "eyJhY2..." \
  --batch-size 20 \
  --batch-delay 300

# 试运行(不实际发送)
python3 batch_send.py \
  --targets targets.txt \
  --message "测试消息" \
  --session "eyJhY2..." \
  --dry-run
```

## 注意事项

1. 脚本仅使用 Python 标准库（`urllib`），无需安装第三方依赖
2. `session_data` 在每次 API 调用后更新，确保 session 链不断裂
3. 遇到 `PEER_FLOOD` 立即停止，这是 Telegram 对账号的严重限制
4. 建议新账号从小量开始测试（5-10 条），确认无风控再逐步增量
